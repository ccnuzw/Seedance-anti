{
  "name": "feicai-studio",
  "version": "0.1.0",
  "description": "FEICAI Studio - AI 驱动的影视短剧制作工作台",
  "main": "./out/main/index.js",
  "author": "FEICAI",
  "license": "MIT",
  "scripts": {
    "ensure:electron": "node ./scripts/ensure-electron.mjs",
    "ensure:native": "electron-builder install-app-deps",
    "sync:runtime": "npm run ensure:electron && npm run ensure:native",
    "dev": "npm run sync:runtime && electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.mts,.cts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "npm run sync:runtime && electron-vite preview",
    "postinstall": "npm run sync:runtime",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "overrides": {
    "dompurify": "3.4.0",
    "postcss": "8.5.14"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@google/generative-ai": "^0.21.0",
    "@xyflow/react": "^12.0.0",
    "better-sqlite3": "^12.9.0",
    "electron-store": "^10.0.0",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "uuid": "^11.1.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^25.6.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "41.5.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "typescript-eslint": "^8.46.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.7.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5"
  }
}
